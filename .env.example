# 複製這個檔案並改名為 .env，再填入你自己的設定
# .env 絕對不要上傳 GitHub、不要貼給別人

# false = 只用規則版（不需要網路與金鑰）；true = 使用 AI，失敗時自動退回規則版
USE_AI=false

# github（預設，免費）或 azure
AI_PROVIDER=github

# GitHub Models：填 GitHub Personal Access Token（需要 models: read 權限）
# Azure OpenAI：填 Azure 入口網站裡的「金鑰」
AI_API_KEY=

# GitHub Models 用的模型名稱（可到 https://github.com/marketplace/models 查）
AI_MODEL=openai/gpt-4.1-mini

# 只有用 Azure 時要填：完整網址，例如
# https://你的資源名稱.openai.azure.com/openai/deployments/你的部署名稱/chat/completions?api-version=2024-10-21
AI_ENDPOINT=

# 單次呼叫逾時秒數（Demo 現場網路慢可以改成 8）
AI_TIMEOUT=5
